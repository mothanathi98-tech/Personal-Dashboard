# Public Supabase connection settings used by the app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side owner allow-list
OWNER_EMAIL=

# Optional server-only key used only for account deletion.
# Keep this secret out of NEXT_PUBLIC_* variables and never commit a real value.
SUPABASE_SECRET_KEY=

# Reminder email settings are Supabase Edge Function secrets, not app .env values.
# Configure RESEND_API_KEY and REMINDER_FROM_EMAIL in the Supabase project settings.
# The reminder worker secret is stored in Supabase Vault by the database setup.
